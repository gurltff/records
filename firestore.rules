rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function myRole() {
      return myProfile().role;
    }

    function sameClass(studentId) {
      let student =
        get(
          /databases/$(database)/documents/users/$(studentId)
        ).data;

      return student.enrolledCourseIds[0]
          == myProfile().enrolledCourseIds[0]
        && student.year
          == myProfile().year;
    }

    function teacherOwnsCourse(courseKey) {
      return myRole() == 'teacher'
        && courseKey in myProfile().assignedCourseIds;
    }

    // USERS
    match /users/{uid} {

      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || myRole() in ['teacher', 'cr']
        );

      /*
       * Registration can create only student or teacher.
       * CR cannot self-register.
       */
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role
          in ['student', 'teacher'];

      /*
       * User can update their own profile,
       * but cannot change their own role.
       *
       * Teacher can promote/demote student <-> CR.
       */
      allow update: if signedIn() && (
        (
          request.auth.uid == uid
          && request.resource.data.role
             == resource.data.role
          && (
            (
              resource.data.role == 'student'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['year'])
            )
            || (
              resource.data.role == 'teacher'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['assignedCourseIds'])
            )
          )
        )
        ||
        (
          myRole() == 'teacher'
          && resource.data.role
             in ['student', 'cr']
          && request.resource.data.role
             in ['student', 'cr']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'role',
              'assignedCourseIds',
              'enrolledCourseIds',
              'year',
              'graduationYear'
            ])
        )
      );

      allow delete: if false;
    }

    // COURSES
    match /courses/{id} {
      allow read: if signedIn();

      allow create, update, delete:
        if signedIn()
        && myRole()
           in ['teacher', 'cr'];
    }

    // ANNOUNCEMENTS
    match /announcements/{id} {

      allow read: if true;

      allow create:
        if signedIn()
        && myRole() == 'cr'
        && request.resource.data.authorId
           == request.auth.uid;

      allow update, delete:
        if signedIn()
        && myRole() == 'cr'
        && resource.data.authorId
           == request.auth.uid;
    }

    // ATTENDANCE
    match /attendanceRecords/{id} {

      /*
       * Student/CR:
       * own records.
       *
       * Teacher:
       * attendance records.
       *
       * CR:
       * only records belonging to their class.
       */
      allow read:
        if signedIn()
        && (
          resource.data.studentId
            == request.auth.uid

          || (
            myRole() == 'teacher'
            && teacherOwnsCourse(
              resource.data.courseKey
            )
          )

          || (
            myRole() == 'cr'
            && sameClass(
              resource.data.studentId
            )
          )
        );

      /*
       * Students and CRs can only create their
       * own self-check-in.
       */
      allow create:
        if signedIn()
        && (
          (
            myRole()
              in ['student', 'cr']
            && request.resource.data.studentId
              == request.auth.uid
            && request.resource.data.source
              == 'student_self_checkin'
          )

          ||

          (
            myRole() == 'teacher'
            && request.resource.data.source
              == 'teacher_marked'
            && request.resource.data.teacherId
              == request.auth.uid
            && teacherOwnsCourse(
              request.resource.data.courseKey
            )
          )
        );

      /*
       * Only the teacher who owns that subject
       * can modify its attendance.
       */
      allow update, delete:
        if signedIn()
        && myRole() == 'teacher'
        && teacherOwnsCourse(
          resource.data.courseKey
        );
    }

    // ATTENDANCE SESSIONS
    match /attendanceSessions/{id} {

      allow read:
        if signedIn()
        && myRole()
           in ['teacher', 'cr'];

      allow create:
        if signedIn()
        && myRole() == 'teacher'
        && request.resource.data.teacherId
           == request.auth.uid
        && teacherOwnsCourse(
          request.resource.data.courseKey
        );

      allow update, delete:
        if signedIn()
        && myRole() == 'teacher'
        && resource.data.teacherId
           == request.auth.uid
        && teacherOwnsCourse(
          resource.data.courseKey
        );
    }

    // TIMETABLE
    match /timetableEntries/{id} {

      allow read:
        if signedIn()
        && resource.data.studentId
           == request.auth.uid;

      allow create:
        if signedIn()
        && request.resource.data.studentId
           == request.auth.uid;

      allow update:
        if signedIn()
        && resource.data.studentId
           == request.auth.uid
        && request.resource.data.studentId
           == request.auth.uid;

      allow delete:
        if signedIn()
        && resource.data.studentId
           == request.auth.uid;
    }

    // =====================================================
    // STUDENT PROFILES (one per student, kept after graduation)
    // =====================================================

    function isTeacher() {
      return signedIn() && myRole() == 'teacher';
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function recordOwner(recordId) {
      return get(
        /databases/$(database)/documents/studentRecords/$(recordId)
      ).data.ownerUid;
    }

    // One record per student, owned by their account once claimed.
    match /studentRecords/{id} {

      // Owner, teachers, or a signed-in user whose verified email is on
      // an unclaimed record (needed to find and claim it on first login).
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || isTeacher()
        || (
          request.auth.token.email_verified == true
          && (
            resource.data.collegeEmail == myEmail()
            || resource.data.personalEmail == myEmail()
          )
        )
      );

      allow create: if signedIn() && (
        isTeacher()
        || (
          myRole() in ['student', 'cr']
          && request.resource.data.ownerUid == request.auth.uid
        )
      );

      allow update: if signedIn() && (
        isTeacher()

        // Owner edits their own record; ownership cannot be handed away.
        || (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
        )

        // Claiming: an unclaimed record whose email matches the signed-in
        // user's verified email, changing nothing but the owner.
        || (
          resource.data.ownerUid == null
          && request.auth.token.email_verified == true
          && (
            resource.data.collegeEmail == myEmail()
            || resource.data.personalEmail == myEmail()
          )
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ownerUid'])
        )
      );

      allow delete: if isTeacher();
    }

    // Proof documents (offer letters, certificates) — private.
    match /recordDocuments/{id} {
      allow read: if signedIn() && (
        isTeacher()
        || recordOwner(resource.data.recordId) == request.auth.uid
      );

      allow create: if signedIn()
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.mimeType
          in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && request.resource.data.dataUrl.size() < 1000000
        && (
          isTeacher()
          || recordOwner(request.resource.data.recordId) == request.auth.uid
        );

      allow update: if false;

      allow delete: if signedIn() && (
        isTeacher()
        || recordOwner(resource.data.recordId) == request.auth.uid
      );
    }

    // Append-only change history.
    match /recordUpdates/{id} {
      allow read: if signedIn() && (
        isTeacher()
        || recordOwner(resource.data.recordId) == request.auth.uid
      );

      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == myRole()
        && (
          isTeacher()
          || recordOwner(request.resource.data.recordId) == request.auth.uid
        );

      allow update, delete: if false;
    }

    // Only teachers can verify. The stored fingerprint makes a
    // verification lapse automatically when the student edits the entry.
    match /recordVerifications/{id} {
      allow read: if signedIn() && (
        isTeacher()
        || recordOwner(resource.data.recordId) == request.auth.uid
      );

      allow create, update: if isTeacher()
        && request.resource.data.verifiedBy == request.auth.uid;

      allow delete: if isTeacher();
    }

    // Update requests ("drives") sent by teachers.
    match /updateDrives/{id} {
      allow read: if signedIn();
      allow create, update: if isTeacher()
        && request.resource.data.createdBy is string;
      allow delete: if isTeacher();
    }

    // Explore: opt-in public card of a profile, written by its owner.
    match /directoryProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid;
      // Teachers can take a card down (e.g. when deleting a record).
      allow delete: if signedIn()
        && (request.auth.uid == uid || isTeacher());
    }

    // DENY EVERYTHING ELSE
    match /{document=**} {
      allow read, write: if false;
    }
  }
}